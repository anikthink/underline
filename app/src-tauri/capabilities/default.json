{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "opener:allow-reveal-item-in-dir",
    "core:event:default",
    "core:window:allow-close"
  ]
}